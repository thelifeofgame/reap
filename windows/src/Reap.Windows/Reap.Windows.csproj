<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows 专用：读进程表和 PEB、监听端口、结束进程、磁盘清理。只用 P/Invoke，不依赖 WinUI，能在其他平台编译检查。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Reap.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Reap.Core/Reap.Core.csproj" />
  </ItemGroup>
</Project>
